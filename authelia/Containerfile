# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

FROM dhi.io/node:26-alpine-dev@sha256:d17376f42ae43fae1792e91f7e8490c9696a5c5309c99befd99648d03769db57 AS frontend

WORKDIR /src

RUN npm install --global pnpm@12

COPY web/ ./web/

RUN pnpm --dir web install --frozen-lockfile --ignore-scripts \
    && pnpm --dir web build

FROM dhi.io/golang:1.27.3-alpine-dev@sha256:bc66efe51594cd50a6cf42d36f8521c6d643bd9be206acf606753ed15b23f0e1 AS builder

ARG APP_VERSION=unknown
ARG APP_REVISION=unknown

WORKDIR /src

RUN apk add --no-cache build-base musl-utils

COPY go.mod go.sum ./

RUN go mod download

COPY . .

COPY --from=frontend /src/internal/server/public_html/ ./internal/server/public_html/

RUN cp -a api/. ./internal/server/public_html/api/ \
    && mkdir -p /out \
    && CGO_ENABLED=1 \
        CGO_CPPFLAGS="-D_FORTIFY_SOURCE=2 -fstack-protector-strong" \
        CGO_LDFLAGS="-Wl,-z,relro,-z,now" \
        go build \
            -buildmode=pie \
            -trimpath \
            -o /out/authelia \
            -ldflags "-linkmode=external -s -w \
                -X github.com/authelia/authelia/v4/internal/utils.BuildTag=${APP_VERSION} \
                -X 'github.com/authelia/authelia/v4/internal/utils.BuildState=tagged clean' \
                -X github.com/authelia/authelia/v4/internal/utils.BuildCommit=${APP_REVISION}" \
            ./cmd/authelia/

RUN set -eux; \
    install -d -o 1000 -g 1000 /runtime-root/app /runtime-root/config; \
    ldd /out/authelia > /tmp/ldd-output; \
    if grep -q "not found" /tmp/ldd-output; then \
        cat /tmp/ldd-output; \
        exit 1; \
    fi; \
    awk '{ \
        if ($2 == "=>" && $3 ~ /^\//) { \
            print $3; \
        } else if ($1 ~ /^\//) { \
            print $1; \
        } \
    }' /tmp/ldd-output | sort -u | while IFS= read -r path; do \
        case "${path}" in \
            /*) \
                mkdir -p "/runtime-root$(dirname "${path}")"; \
                cp -L "${path}" "/runtime-root${path}"; \
                ;; \
        esac; \
    done

FROM dhi.io/static:20261020-alpine@sha256:c78b2c2034b3fb2f83a337b6353c3ef27d910a828d9127ff342014e7b225c04e AS runtime

WORKDIR /app

COPY --from=builder /runtime-root/ /
COPY --from=builder --chown=1000:1000 /out/authelia /app/authelia
COPY --chown=1000:1000 LICENSE /app/LICENSE

ENV PATH="/app:${PATH}" \
    X_AUTHELIA_CONFIG=/config/configuration.yml

USER 1000:1000

EXPOSE 9091

ENTRYPOINT ["/app/authelia"]
CMD ["--config", "/config/configuration.yml"]
