    },
    {
      "repository": "https://github.com/userdocs/qbittorrent-nox-static",
      "version": "release-5.3.0_v2.1.2",
      "containerfile": "images/qbittorrent/Containerfile",
      "image": "qbittorrent",
      "metadata": {
        "org.opencontainers.image.title": "qBittorrent",
        "org.opencontainers.image.description": "Open-source BitTorrent client with a web interface",
        "org.opencontainers.image.url": "https://www.qbittorrent.org/",
