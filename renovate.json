{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker"
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^releases\\.json$/"
      ],
      "matchStrings": [
        "$.repositories.{\"depName\": $replace(repository, /^https:\\/\\/github\\.com\\//, \"\"), \"currentValue\": version}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.jsonata",
    "npm",
    "pip_requirements",
    "renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    }
  ]
}